<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="550.0" prefWidth="850.0" spacing="15.0" style="-fx-background-color: #f4f4f9; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.pataverde.controller.MainController">
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Registro de pacientes" />

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Formulario (Izquierda) -->
                <VBox prefWidth="320.0" spacing="10.0">
                    <children>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="80.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="30.0" />
                            </rowConstraints>
                            <children>
                                <Label text="Tipo:" />
                                <ComboBox fx:id="cbTipo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />

                                <Label text="Nombre:" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Edad:" GridPane.rowIndex="2" />
                                <TextField fx:id="txtEdad" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Peso (kg):" GridPane.rowIndex="3" />
                                <TextField fx:id="txtPeso" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            </children>
                        </GridPane>

                        <!-- Sección Perro -->
                        <TitledPane collapsible="false" text="Datos del perro">
                            <content>
                                <VBox fx:id="boxPerro" spacing="8.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label minWidth="60.0" text="Raza:" />
                                                <TextField fx:id="txtRaza" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <CheckBox fx:id="chkVacunado" text="Vacunado" />
                                        <CheckBox fx:id="chkAdopcion" text="Disponible para adopción" />
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- Sección Gato -->
                        <TitledPane collapsible="false" text="Datos del gato">
                            <content>
                                <VBox fx:id="boxGato" spacing="8.0">
                                    <children>
                                        <CheckBox fx:id="chkExterior" text="Vive en exterior" />
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button onAction="#handleRegistrar" style="-fx-padding: 6 16;" text="Registrar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Tabla y Botón Eliminar (Derecha) -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tblMascotas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTipo" prefWidth="90.0" text="Tipo" />
                                <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                                <TableColumn fx:id="colEdad" prefWidth="70.0" text="Edad" />
                                <TableColumn fx:id="colPeso" prefWidth="90.0" text="Peso (kg)" />
                                <TableColumn fx:id="colCosto" prefWidth="120.0" text="Costo consulta" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox>
                            <children>
                                <Button onAction="#handleEliminar" style="-fx-padding: 6 16;" text="Eliminar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Area de Mensajes Informativos -->
        <Label fx:id="lblMensaje" wrapText="true" />
    </children>
</VBox>